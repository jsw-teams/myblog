{
  "name": "blog-js-gripe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node src/assets.mjs",
    "prebuild": "node src/assets.mjs",
    "build": "astro build",
    "news:mvp": "node scripts/news-mvp/generate-weekly-news.mjs",
    "postbuild": "node scripts/finalize-astro-build.mjs",
    "serve": "astro preview --host 127.0.0.1",
    "check": "node scripts/check-build.mjs",
    "predeploy": "npm run build && npm run check",
    "deploy": "wrangler pages deploy public --project-name blog-js-gripe --branch main",
    "predeploy:production": "npm run build && npm run check",
    "deploy:production": "wrangler pages deploy public --project-name blog-js-gripe --branch main"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.2.1",
    "fast-glob": "^3.3.3",
    "feed": "^4.2.2",
    "gray-matter": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "sharp": "^0.34.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.85.0"
  }
}
