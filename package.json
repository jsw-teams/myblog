{
  "name": "blog-js-gripe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node src/assets.mjs",
    "prebuild": "node src/prebuild.mjs",
    "build": "astro build",
    "postbuild": "node scripts/postbuild-host-aware.mjs",
    "deploy:local": "/opt/deploy-hooks/bin/deploy-myblog.sh",
    "deploy:local:blog-only": "SKIP_MYWEB_REBUILD=1 /opt/deploy-hooks/bin/deploy-myblog.sh",
    "news:mvp": "node scripts/news-mvp/generate-weekly-news.mjs",
    "serve": "astro preview --host 127.0.0.1",
    "check": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "astro": "^6.2.1",
    "fast-glob": "^3.3.3",
    "feed": "^4.2.2",
    "gray-matter": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "katex": "^0.18.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-texmath": "^1.0.0",
    "sharp": "^0.34.1"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "typescript": "^5.9.3"
  }
}
